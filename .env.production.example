# Production Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# CRITICAL: This file documents the production configuration that must be set
# before building the production APK. The values below are PLACEHOLDERS and
# must be replaced with actual production values.

# ─── Backend API URL ──────────────────────────────────────────────────────────
# The production backend URL is NOT YET DEPLOYED.
#
# Per docs/deployment.md:
# - Backend hosting decision is marked as [OPEN]
# - No backend code has been deployed
# - Candidates: Railway, Render, Fly.io, VPS (Hetzner/DigitalOcean), AWS
#
# BEFORE BUILDING THE PRODUCTION APK:
# 1. Deploy the backend to your chosen hosting provider
# 2. Obtain the public HTTPS URL (e.g., https://api.asassociates.com/v1)
# 3. Replace the placeholder below with the actual production URL
# 4. Verify the URL is reachable and returns expected responses
#
# IMPORTANT:
# - Must be HTTPS (not HTTP) in production
# - Must NOT include 10.0.2.2 or localhost
# - This value is embedded in the APK and visible to anyone with the app
# - NEVER put secrets in EXPO_PUBLIC_* variables

EXPO_PUBLIC_API_URL=https://REPLACE_WITH_ACTUAL_PRODUCTION_BACKEND_URL/api/v1

# ─── Example Production URLs ──────────────────────────────────────────────────
# Railway:  https://as-associates-backend-production.up.railway.app/api/v1
# Render:   https://as-associates-api.onrender.com/api/v1
# Custom:   https://api.asassociates.com/v1
# Fly.io:   https://as-associates-api.fly.dev/api/v1
